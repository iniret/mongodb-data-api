# Server Configuration
PORT=7438

# MongoDB Configuration (Default Cluster)
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net"
MONGO_OPTIONS="?retryWrites=true&w=majority"

# Additional MongoDB Clusters (Optional)
# Format: MONGO_URI_<CLUSTER_NAME> and MONGO_OPTIONS_<CLUSTER_NAME>
# Example:
# MONGO_URI_CLUSTER1="mongodb+srv://username:password@cluster1.mongodb.net"
# MONGO_OPTIONS_CLUSTER1="?retryWrites=true&w=majority"
# MONGO_URI_CLUSTER2="mongodb+srv://username:password@cluster2.mongodb.net"
# MONGO_OPTIONS_CLUSTER2="?retryWrites=true&w=majority"

# API Security
API_KEY="your_secure_api_key_here"
API_SECRET="your_secure_api_secret_here"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_MESSAGE="Too many requests, please try again later."